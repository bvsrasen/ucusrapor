<mxfile><diagram name="Önerilen süreç: kayıt, karşılaştırma ve kontrol listesi"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Önerilen süreç: kayıt, karşılaştırma ve kontrol listesi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Her test iki UKB'de kaydediliyor, UçuşRapor ile karşılaştırılıyor, karar raporla veriliyor&lt;/font&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="2343" height="60" as="geometry"/></mxCell><mxCell id="L1" value="Aviyonik&lt;br&gt;Ekibi" style="swimlane;horizontal=0;startSize=48;fillColor=#C9DAF0;swimlaneFillColor=#EEF4FB;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="140" width="2343" height="230" as="geometry"/></mxCell><mxCell id="L2" value="UçuşRapor" style="swimlane;horizontal=0;startSize=48;fillColor=#C5E3C6;swimlaneFillColor=#EEF7EE;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="370" width="2343" height="125" as="geometry"/></mxCell><mxCell id="L3" value="Takım" style="swimlane;horizontal=0;startSize=48;fillColor=#F6D9B3;swimlaneFillColor=#FFF7EE;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="495" width="2343" height="125" as="geometry"/></mxCell><mxCell id="L4" value="Atış&lt;br&gt;Alanı" style="swimlane;horizontal=0;startSize=48;fillColor=#D9D9D9;swimlaneFillColor=#F3F3F3;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="620" width="2343" height="230" as="geometry"/></mxCell><mxCell id="bas" value="Test günü" style="shape=mxgraph.bpmn.event;outline=standard;symbol=general;perimeter=ellipsePerimeter;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#D5E8D4;strokeColor=#2E7D32;html=1;" vertex="1" parent="L1"><mxGeometry x="124" y="40" width="44" height="44" as="geometry"/></mxCell><mxCell id="a1" value="Testi yap, iki UKB'de&lt;br&gt;de kaydı başlat" style="shape=mxgraph.bpmn.task2;taskMarker=use