<mxfile><diagram name="TO-BE: UçuşRapor ile Hedef Süreç"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;TO-BE: UçuşRapor ile Hedef Süreç&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Toplam ≈ 25 dk insan emeği  •  sistem işlemi &lt; 1 sn  •  4 görev otomatik  •  döngü yok&lt;/font&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="2343" height="60" as="geometry"/></mxCell><mxCell id="L1" value="Aviyonik&lt;br&gt;Ekip Üyesi" style="swimlane;horizontal=0;startSize=48;fillColor=#C9DAF0;swimlaneFillColor=#EEF4FB;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="120" width="2343" height="230" as="geometry"/></mxCell><mxCell id="L2" value="UçuşRapor&lt;br&gt;Sistemi" style="swimlane;horizontal=0;startSize=48;fillColor=#C5E3C6;swimlaneFillColor=#EEF7EE;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="2343" height="125" as="geometry"/></mxCell><mxCell id="L3" value="Takım&lt;br&gt;Kaptanı" style="swimlane;horizontal=0;startSize=48;fillColor=#F6D9B3;swimlaneFillColor=#FFF7EE;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="475" width="2343" height="125" as="geometry"/></mxCell><mxCell id="bas" value="Uçuş/test bitti" style="shape=mxgraph.bpmn.event;outline=standard;symbol=general;perimeter=ellipsePerimeter;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#D5E8D4;strokeColor=#2E7D32;html=1;" vertex="1" parent="L1"><mxGeometry x="124" y="40" width="44" height="44" as="geometry"/></mxCell><mxCell id="a1" value="SD karttan&lt;br&gt;CSV'yi kopyala&lt;br&gt;&lt;b&gt;~5 dk&lt;/b&gt;" style="shape=mxgraph.bpmn.task2;taskMarker=user;rectStyle=rounded;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#404040;strokeWidth=1;fontSize=11;" vertex="1" parent="L1"><mxGeometry x="252" y="32" width="138" height="62" as="geometry"/></mxCell><mxCell id="a2"